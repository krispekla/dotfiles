#!/usr/bin/env bash
# Blocks commits that would put secrets or machine-specific home paths in the repo.
# Enabled by install.sh (git config core.hooksPath .githooks).
set -uo pipefail

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
fail=0

# 1. Secrets: tokens, API keys, private keys
if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks not installed (brew bundle --file=Brewfile). Refusing to commit unscanned." >&2
  exit 1
fi
if ! gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1 . >&2; then
  echo "pre-commit: possible secret above. Move it to a local file outside the repo (e.g. ~/.zshenv.local)." >&2
  fail=1
fi

# 2. Absolute home paths (/Users/<name>/...) in added lines: use ~ or $HOME,
#    or move machine-specific paths to a local file outside the repo.
paths=$(git diff --cached -U0 --no-color | grep -E '^\+[^+]' | grep -E '/Users/[A-Za-z0-9._-]+' || true)
if [ -n "$paths" ]; then
  echo "pre-commit: absolute home path(s) in staged changes:" >&2
  echo "$paths" | sed 's/^/    /' >&2
  echo "Use ~ or \$HOME, or move machine-specific paths to a local file outside the repo." >&2
  fail=1
fi

exit $fail

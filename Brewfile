# Tools this setup needs. Install with: brew bundle --file=Brewfile
# herdr and hunk are not on Homebrew — see README.

tap "nikitabobko/tap"

# Editor + git UI
brew "neovim"
brew "lazygit"
brew "gh"

# Used by herdr scripts and the Claude status line
brew "jq"

# herdr popup file browser (prefix+f) and shell fuzzy search
brew "lf"
brew "fzf"

# LazyVim pickers and language servers (typescript/tailwind extras)
brew "ripgrep"
brew "fd"
brew "node"

# Apps
cask "ghostty"
cask "nikitabobko/tap/aerospace"

# Fonts
cask "font-atkinson-hyperlegible-mono"

# Copy to ~/.config/herdr/worktree-setup/<repo>.work (<repo> = the main checkout's folder name).
# Extra tabs for work worktrees (cmd+shift+g). One tab per line:  name | command
#   {port}    this worktree's own port (unique across worktrees, from 3100 up; also $PORT in its shells)
#   {branch}  the worktree's branch
# Commands start after <repo>.sh (install/setup) has finished. Lines starting with # are ignored.

# PORT=… works when the app reads it (Next.js, Express). Vite and others need a flag instead:
#   dev:{port} | pnpm exec vite dev --port {port} --strictPort
dev:{port} | PORT={port} pnpm dev
